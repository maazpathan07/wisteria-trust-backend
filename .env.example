# ==========================================
# Wisteria Trust Backend - Environment Config
# ==========================================

# Server Port
PORT=5000

# MongoDB Connection String (Atlas or Local)
# Supports both MONGO_URI and MONGODB_URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/wisteria_trust?retryWrites=true&w=majority

# Admin Credentials
ADMIN_EMAIL=admin@wisteriatrust.com
# Generated via: node generateHash.js (Default: Admin@123)
ADMIN_PASSWORD_HASH=$2a$10$w82fX9i10cW62402t8kCZeTz.0v4NqQ127391.8V0.qL142

# JWT Secret Key for Authenticated Sessions
JWT_SECRET=wisteria_sovereign_trust_jwt_secret_key_2025_luxury_protocol

# Allowed CORS Origins (Optional, default allows all during dev)
CORS_ORIGIN=*
